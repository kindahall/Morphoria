* text=auto

# Unity YAML assets should stay text-mergeable.
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.controller text eol=lf
*.anim text eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.glb binary
*.gltf binary
*.fbx binary
*.mp4 binary
*.mov binary
*.zip binary
